<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Explosive Weapons __________-->

    <!-- 25mm Grenade Launcher -->

    <ThingDef ParentName="FCP_Simple_Gun_Base">
        <defName>FCP_Gun_25MM_Grenade_Launcher</defName>
        <label>25mm Grenade Launcher</label>
        <description>A single-shot grenade launcher chambered for 25mm grenades. Lighter and more portable than most explosive weapons, making it popular among wastelanders who need indirect fire capability without the bulk of heavier launchers.</description>
        <smeltable>false</smeltable>
        <graphicData>
            <texPath>Explosive/FCP_25MM_Grenade_Launcher</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <soundInteract>Interact_Rifle</soundInteract>
        <recipeMaker MayRequire="Rick.FCP.Wastelanders">
            <researchPrerequisites>
                <li>FCP_Research_Advanced_Weapons_Manufacturing</li>
                <li>FCP_Research_Blueprint_25mmGrenadeLauncher</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>8</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>FCP_Production_Complex_Weapons_Workbench</li>
                <li>TableMachining</li>
            </recipeUsers>
        </recipeMaker>
        <thingSetMakerTags>
            <li>RewardStandardQualitySuper</li>
        </thingSetMakerTags>
        <statBases>
            <MarketValue>750</MarketValue>
            <WorkToMake>60000</WorkToMake>
            <Mass>6.5</Mass>
            <AccuracyTouch>0.50</AccuracyTouch>
            <AccuracyShort>0.60</AccuracyShort>
            <AccuracyMedium>0.70</AccuracyMedium>
            <AccuracyLong>0.65</AccuracyLong>
            <RangedWeapon_Cooldown>2.8</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>90</Steel>
            <ComponentIndustrial>6</ComponentIndustrial>
            <Chemfuel>20</Chemfuel>
        </costList>
        <weaponTags>
            <li>FCP_25MM_Grenade_Launcher</li>
            <li>FCP_Heavy_Weapon</li>
        </weaponTags>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>FCP_Proj_Grenade_Fragmentation</defaultProjectile>
                <forcedMissRadius>0.9</forcedMissRadius>
                <warmupTime>1.8</warmupTime>
                <ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
                <range>28</range>
                <burstShotCount>1</burstShotCount>
                <soundCast>Shot_IncendiaryLauncher</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>10</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>10</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <comps>
            <li Class="FCP.Core.CompProperties_LabelColored">
                <rarity>Rare</rarity>
            </li>
        </comps>
    </ThingDef>

    <!-- Grenade Machine Gun -->

    <ThingDef ParentName="FCP_Simple_Gun_Base">
        <defName>FCP_Gun_Grenade_Machinegun</defName>
        <label>Grenade Machine Gun</label>
        <description>A belt-fed automatic grenade launcher firing 40mm grenades in rapid succession. Originally designed for vehicle mounting, it was adapted for power armor infantry use. The high rate of fire allows it to saturate an area with explosives, making it effective for area denial and defensive operations.</description>
        <smeltable>false</smeltable>
        <graphicData>
            <texPath>Explosive/FCP_Grenade_Machinegun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <soundInteract>Interact_Rifle</soundInteract>
        <recipeMaker MayRequire="Rick.FCP.Wastelanders">
            <researchPrerequisites>
                <li>FCP_Research_Advanced_Weapons_Manufacturing</li>
                <li>FCP_Research_Blueprint_GrenadeMachineGun</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>8</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>FCP_Production_Complex_Weapons_Workbench</li>
                <li>TableMachining</li>
            </recipeUsers>
        </recipeMaker>
        <thingSetMakerTags>
            <li>RewardStandardQualitySuper</li>
        </thingSetMakerTags>
        <statBases>
            <MarketValue>1350</MarketValue>
            <WorkToMake>60000</WorkToMake>
            <Mass>16.5</Mass>
            <AccuracyTouch>0.30</AccuracyTouch>
            <AccuracyShort>0.40</AccuracyShort>
            <AccuracyMedium>0.55</AccuracyMedium>
            <AccuracyLong>0.50</AccuracyLong>
            <RangedWeapon_Cooldown>3.8</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>90</Steel>
            <ComponentIndustrial>6</ComponentIndustrial>
            <Chemfuel>20</Chemfuel>
        </costList>
        <weaponTags>
            <li>FCP_Grenade_Machinegun</li>
            <li>FCP_Heavy_Weapon</li>
            <li>FCP_Power_Armor_Required</li>
        </weaponTags>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>FCP_Proj_Grenade_Fragmentation</defaultProjectile>
                <forcedMissRadius>1.5</forcedMissRadius>
                <warmupTime>2.8</warmupTime>
                <ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
                <range>30</range>
                <burstShotCount>8</burstShotCount>
                <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
                <soundCast>Shot_IncendiaryLauncher</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>15</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>barrel</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>15</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <comps>
            <li Class="FCP.Core.CompProperties_LabelColored">
                <rarity>Rare</rarity>
            </li>
            <li Class="FCP.Core.Backpacks.CompProperties_WeaponBackpack">
                <backpackTexPath>Things/Pawn/Backpacks/Ammo_Backpack/FCP_Ammo_Backpack</backpackTexPath>
                <backpackScale>1.0</backpackScale>
                <drawBackOnlyWhenDrafted>false</drawBackOnlyWhenDrafted>
                <northOffset>(0, 0.04, -0.10)</northOffset>
                <southOffset>(0, -0.04, -0.10)</southOffset>
                <eastOffset>(-0.3, 0.04, -0.10)</eastOffset>
            </li>
        </comps>
        <modExtensions>
            <li Class="FCP.Core.WeaponRequirementExtension">
                <requirements>
                    <li Class="FCP.Core.WeaponRequirement_AnyInner">
                        <requirements>
                            <li Class="FCP.Core.WeaponRequirement_AnyApparel">
                                <requiredApparel>
                                    <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Power_Armor_Frame</li>
                                </requiredApparel>
                            </li>
                        </requirements>
                    </li>
                </requirements>
            </li>
        </modExtensions>
    </ThingDef>

    <!-- Missile Launcher -->

    <ThingDef ParentName="FCP_Simple_Gun_Base">
        <defName>FCP_Gun_Missile_Launcher</defName>
        <label>Missile Launcher</label>
        <description>A pre-war shoulder-fired missile launcher. Fires fin-stabilized high-explosive missiles effective against armored targets and structures. Simple, reliable, and still highly valued in the wasteland despite the scarcity of ammunition.</description>
        <smeltable>false</smeltable>
        <graphicData>
            <texPath>Explosive/FCP_Missile_Launcher</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <equippedAngleOffset>45</equippedAngleOffset>
        <soundInteract>Interact_Rifle</soundInteract>
        <recipeMaker MayRequire="Rick.FCP.Wastelanders">
            <researchPrerequisites>
                <li>FCP_Research_Advanced_Weapons_Manufacturing</li>
                <li>FCP_Research_Blueprint_MissileLauncher</li>
            </researchPrerequisites>
            <skillRequirements>
                <Crafting>8</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>FCP_Production_Complex_Weapons_Workbench</li>
                <li>TableMachining</li>
            </recipeUsers>
        </recipeMaker>
        <thingSetMakerTags>
            <li>RewardStandardQualitySuper</li>
        </thingSetMakerTags>
        <statBases>
            <MarketValue>1100</MarketValue>
            <WorkToMake>60000</WorkToMake>
            <Mass>10.0</Mass>
            <AccuracyTouch>0.45</AccuracyTouch>
            <AccuracyShort>0.55</AccuracyShort>
            <AccuracyMedium>0.65</AccuracyMedium>
            <AccuracyLong>0.70</AccuracyLong>
            <RangedWeapon_Cooldown>4.5</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>90</Steel>
            <ComponentIndustrial>6</ComponentIndustrial>
            <Chemfuel>20</Chemfuel>
        </costList>
        <weaponTags>
            <li>FCP_Missile_Launcher</li>
            <li>FCP_Heavy_Weapon</li>
