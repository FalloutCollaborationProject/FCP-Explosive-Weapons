    <!-- Fatman -->

    <ThingDef ParentName="FCP_Simple_Gun_Base">
        <defName>FCP_Gun_Fatman</defName>
        <label>Fat Man</label>
        <description>The M42 Fat Man is a portable nuclear catapult that launches miniature atomic warheads. Originally issued to power armor units during the war, it remains one of the most destructive man-portable weapons ever created. Extreme caution advised when operating near friendly forces.</description>
        <smeltable>false</smeltable>
        <graphicData>
            <texPath>Explosive/FCP_Fatman</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <soundInteract>Interact_Rifle</soundInteract>
        <recipeMaker MayRequire="Rick.FCP.Wastelanders">
