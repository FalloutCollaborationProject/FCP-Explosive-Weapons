<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Grenade Recipes __________-->

    <!-- Note: Only wasteland-made grenades are craftable. Pre-war grenades must be found, traded, or obtained through quests. -->

    <!--_____ Simple Wasteland Grenades _____-->

    <!-- Tincan Grenade Recipe -->

    <RecipeDef MayRequire="Rick.FCP.Wastelanders">
        <defName>FCP_Make_Grenade_Tincan</defName>
        <label>make tincan grenades</label>
        <description>Craft crude tincan grenades from scrap metal and explosives.</description>
        <jobString>Making tincan grenades.</jobString>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <effectWorking>Smith</effectWorking>
        <soundWorking>Recipe_Smith</soundWorking>
        <workAmount>8000</workAmount>
        <workSkill>Crafting</workSkill>
        <recipeUsers>
            <li>FCP_Production_Simple_Weapons_Workbench</li>
            <li>TableMachining</li>
        </recipeUsers>
        <skillRequirements>
            <Crafting>3</Crafting>
        </skillRequirements>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>15</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Chemfuel</li>
                    </thingDefs>
                </filter>
                <count>40</count>
            </li>
        </ingredients>
        <products>
            <FCP_Grenade_Tincan>1</FCP_Grenade_Tincan>
        </products>
        <researchPrerequisite>Machining</researchPrerequisite>
        <researchPrerequisites>
            <li>FCP_Research_Blueprint_TincanGrenade</li>
        </researchPrerequisites>
        <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    </RecipeDef>

