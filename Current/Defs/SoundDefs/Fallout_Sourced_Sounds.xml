<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Sounds sourced from Fallout 3 / New Vegas __________-->

    <!--_____ Grenade Explosions _____-->

    <!-- Fragmentation Grenade -->

    <SoundDef>
        <defName>FCP_Explosion_Frag</defName>
        <context>MapOnly</context>
        <maxSimultaneous>1</maxSimultaneous>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>Explosions/FCP_Frag_Explosion_01</clipPath>
                    </li>
                    <li Class="AudioGrain_Clip">
                        <clipPath>Explosions/FCP_Frag_Explosion_02</clipPath>
                    </li>
                </grains>
                <volumeRange>75~75</volumeRange>
                <pitchRange>0.95~1.05</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

