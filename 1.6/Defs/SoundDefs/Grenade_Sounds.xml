                    <li Class="AudioGrain_Clip">
                        <clipPath>Explosions/FCP_Bottlecap_Explosion</clipPath>
                    </li>
                </grains>
                <volumeRange>60~60</volumeRange>
                <pitchRange>0.95~1.05</pitchRange>
            </li>
        </subSounds>
