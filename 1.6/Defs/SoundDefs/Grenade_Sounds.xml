    <!-- Plasma Grenade -->

    <SoundDef>
        <defName>FCP_Explosion_Plasma</defName>
        <context>MapOnly</context>
        <maxSimultaneous>1</maxSimultaneous>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>Explosions/FCP_Plasma_Grenade_Explosion</clipPath>
